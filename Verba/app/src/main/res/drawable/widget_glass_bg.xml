<?xml version="1.0" encoding="utf-8"?>
<!--
  Frosted black glass. Android does not let a widget blur the wallpaper behind
  it, so the frost is near-solid: you see no shapes from the wallpaper, only a
  dark surface with a fine grain. The coloured glow is a separate layer
  (widget_glow) so Verba can tint it with the current accent colour.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#F20D0D0D" />
        </shape>
    </item>
    <!-- frosted grain -->
    <item>
        <bitmap
            android:src="@drawable/grain"
            android:tileMode="repeat" />
    </item>
    <!-- faint sheen + hairline rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="270"
                android:centerY="0.4"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#0FFFFFFF"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" />
        </shape>
    </item>
</layer-list>
